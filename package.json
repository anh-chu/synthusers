{
  "name": "synthusers",
  "version": "0.1.0",
  "description": "Persona-driven synthetic-user testing harness. Sample realistic personas, let an LLM play each one, run them through a project-defined scenario, and aggregate a report.",
  "type": "module",
  "bin": {
    "synthusers": "./src/cli.ts"
  },
  "scripts": {
    "run": "tsx src/cli.ts",
    "download-personas": "tsx scripts/download-personas.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.0.0",
    "@ai-sdk/openai": "^1.0.0",
    "ai": "^4.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
